# URL base da instância WAHA
WAHA_URL=http://localhost:3000

# Nome da sessão do WhatsApp no WAHA
WAHA_SESSION=default

# Chave da API do WAHA (deixe vazio se a instância não exigir)
WAHA_API_KEY=

# Caminho do arquivo de agendamentos (fora do versionamento)
SCHEDULES_PATH=./data/schedules.json

# Caminho do log de envios (JSONL)
LOG_PATH=./logs/sends.jsonl

# Intervalo aleatório entre envios, em milissegundos (evita bloqueio por flood)
DELAY_MIN_MS=3000
DELAY_MAX_MS=8000

# Fuso horário usado pelos agendamentos cron
TIMEZONE=America/Sao_Paulo

# Porta da tela de agendamentos. O default não é 3000 de propósito: essa é a
# porta default do próprio WAHA, e quem roda o WAHA local bateria em
# "porta já em uso" ao subir a tela. O host não é configurável: a tela sempre
# escuta em 127.0.0.1, porque essa inalcançabilidade de fora é o que
# dispensa autenticação própria nesta tela.
UI_PORT=3010
